    "src/*",
    "*.json",
    "*.js"
  ],
  "dependencies": {
    "core-js": "^3.4.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^9.20.1",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.5.1",
    "vite": "^6.1.0",
    "vite-plugin-vue-devtools": "^7.7.2"
  },
  "keywords": [
    "vue",
    "illustrations",
    "svg",
    "undraw",
    "icons"
